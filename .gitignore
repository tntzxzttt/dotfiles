# Ignore everything by default
*

# Track this file and README
!.gitignore
!README.md
!CONTRIBUTING.md

# WHITELIST
# Manage config directories and their contents below.
!.config/
!.config/fish/
!.config/fish/**
!.config/nvim/
!.config/nvim/**
!.config/git/
!.config/git/**
!.config/ghostty/
!.config/ghostty/**
!.config/helix/
!.config/helix/**
!.config/herdr/
!.config/herdr/config.toml
!.config/tmux/
!.config/tmux/**
!.config/zed/
!.config/zed/settings.json
!.config/starship.toml
!.tmux
!.tmux/**

!.claude
!.claude/**
!.github
!.github/**
!.githooks
!.githooks/**
!.editorconfig
!.markdownlint-cli2.yaml
!docs
!docs/**
!scripts
!scripts/**
!lefthook.yaml
!CLAUDE.md
!LICENSE
!Brewfile
!install.sh

# EXCEPTIONS
# Ignore the following files and directories,
# even if they are located within the directories listed in the whitelist above.
.claude/settings.local.json
.config/tmux/plugins/
.config/fish/conf.d/*.local.fish
.config/fish/functions/__sdkman-noexport-init.sh
