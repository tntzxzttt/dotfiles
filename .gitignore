# Ignore everything by default
*

# Track this file and README
!.gitignore
!README.md

# WHITELIST
# Manage config directories and their contents below.
!.config/
!.config/fish/
!.config/fish/**
!.config/nvim/
!.config/nvim/**
!.config/git/
!.config/git/**
!.config/ghostty/
!.config/ghostty/**
!.config/tmux/
!.config/tmux/**
!.config/starship.toml
!.tmux
!.tmux/**

!.claude
!.claude/**
!.github
!.github/**
!.githooks
!.githooks/**
!.editorconfig
!scripts
!scripts/**
!lefthook.yaml
!CLAUDE.md

# EXCEPTIONS
# Ignore the following files and directories,
# even if they are located within the directories listed in the whitelist above.
.claude/settings.local.json 
.config/tmux/plugins/
.config/fish/conf.d/*.local.fish
.config/fish/functions/__sdkman-noexport-init.sh
